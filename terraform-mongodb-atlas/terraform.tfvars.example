# MongoDB Atlas Provider Configuration
# Get these from: https://cloud.mongodb.com/v2#/org/{ORG_ID}/access/apiKeys
mongodbatlas_public_key  = "your-atlas-public-key"
mongodbatlas_private_key = "your-atlas-private-key"

# Atlas Organization and Project
# Get this from: https://cloud.mongodb.com/v2#/preferences/organizations
atlas_org_id = "your-atlas-organization-id"

project_name = "mongodb-production-cluster"

project_tags = {
  Environment = "production"
  Team        = "platform"
  Purpose     = "sharded-cluster"
  Owner       = "platform-team"
}

# Cluster Configuration
cluster_name    = "prod-sharded-cluster"
mongodb_version = "7.0"

cluster_labels = {
  environment = "production"
  team        = "platform"
  purpose     = "main-database"
}

cluster_tags = {
  Environment = "production"
  Team        = "platform"
  CostCenter  = "engineering"
}

# Shards Configuration - 2 shards with 3 nodes each
shards_config = [
  {
    num_shards = 2
    zone_name  = "Production Zone"
    regions = [
      {
        region_name             = "US_EAST_1"
        provider_name          = "AWS"
        priority               = 7
        electable_nodes        = 3
        read_only_nodes        = 0
        instance_size          = "M30"
        min_instance_size      = "M10"
        max_instance_size      = "M80"
        analytics_instance_size = "M30"
        analytics_node_count    = 1
        readonly_instance_size  = "M30"
      }
    ]
  }
]

# Backup Configuration
backup_enabled                 = true
pit_enabled                   = true
termination_protection_enabled = true

# BI Connector Configuration
bi_connector_enabled = false

# Auto-scaling Configuration
auto_scaling_disk_gb_enabled = true
auto_scaling_compute_enabled = true
compute_scale_down_enabled   = true

# Advanced Configuration
fail_index_key_too_long              = false
javascript_enabled                   = true
minimum_enabled_tls_protocol         = "TLS1_2"
no_table_scan                       = false
oplog_size_mb                       = 2048
sample_size_bi_connector            = 5000
sample_refresh_interval_bi_connector = 300
transaction_lifetime_limit_seconds   = 60

# Network Access Configuration
# IMPORTANT: Restrict to your actual IP ranges in production
ip_access_list = {
  "203.0.113.0/24" = "Office network"
  "198.51.100.0/24" = "Development network"
  # "0.0.0.0/0" = "Allow all IPs (not recommended for production)"
}

# Database Users Configuration
# IMPORTANT: Use strong passwords and consider using AWS Secrets Manager
database_users = {
  "app_user" = {
    username           = "app_user"
    password           = "YourSecurePassword123!"
    auth_database_name = "admin"
    roles = [
      {
        role_name     = "readWriteAnyDatabase"
        database_name = "admin"
      }
    ]
    scopes = []
    labels = {
      environment = "production"
      purpose     = "application"
    }
  }
  "readonly_user" = {
    username           = "readonly_user"
    password           = "YourReadOnlyPassword123!"
    auth_database_name = "admin"
    roles = [
      {
        role_name     = "readAnyDatabase"
        database_name = "admin"
      }
    ]
    scopes = []
    labels = {
      environment = "production"
      purpose     = "analytics"
    }
  }
  "backup_user" = {
    username           = "backup_user"
    password           = "YourBackupPassword123!"
    auth_database_name = "admin"
    roles = [
      {
        role_name     = "backup"
        database_name = "admin"
      }
    ]
    scopes = []
    labels = {
      environment = "production"
      purpose     = "backup"
    }
  }
}

# AWS Configuration for Private Endpoints and Peering
aws_region     = "us-east-1"
aws_account_id = "123456789012"  # Your AWS Account ID

# VPC Configuration (if using private endpoints or peering)
aws_vpc_id   = "vpc-12345678"
aws_vpc_cidr = "10.0.0.0/16"

# Subnet IDs for private endpoints
aws_subnet_ids = [
  "subnet-12345678",
  "subnet-87654321",
  "subnet-abcdef12"
]

# Security Group IDs for private endpoints
aws_security_group_ids = [
  "sg-12345678"
]

# Atlas CIDR block for network peering
atlas_cidr_block = "192.168.248.0/21"

# Feature Flags
enable_private_endpoint = false  # Set to true if you want private endpoints
enable_network_peering  = false  # Set to true if you want VPC peering
enable_data_lake       = false  # Set to true if you want data lake
enable_search_index    = false  # Set to true if you want search index

# Data Lake Configuration (if enabled)
data_lake_database   = "analytics"
data_lake_collection = "events"
data_lake_s3_bucket  = "your-data-lake-bucket"

# Search Index Configuration (if enabled)
search_index_name       = "default_search_index"
search_index_database   = "app"
search_index_collection = "products"
search_index_mappings_dynamic = true
search_index_mappings_fields  = "{}"